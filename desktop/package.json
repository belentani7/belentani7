{
  "name": "belentani",
  "version": "0.5.0",
  "main": "src/main.js",
  "bin": { "bellentani": "bellentani-cli.js" },
  "scripts": {
    "test": "node tests/audit.test.js && node bellentani-cli.js doctor && node bellentani-cli.js audit",
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "IDE agentico persistente y gobernado por PVC-U para Windows 11",
  "repository": { "type": "git", "url": "https://github.com/belentani7/belentani7.git" },
  "bugs": { "url": "https://github.com/belentani7/belentani7/issues" },
  "homepage": "https://github.com/belentani7/belentani7",
  "productName": "Bellentani",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "monaco-editor": "^0.53.0",
    "uuid": "^14.0.1"
  },
  "build": {
    "appId": "com.bellentani.desktop",
    "files": ["src/**/*", "package.json", "node_modules/monaco-editor/min/**/*", "node_modules/monaco-editor/package.json", "node_modules/uuid/**/*", "node_modules/uuid/package.json"],
    "win": {
      "target": "portable",
      "artifactName": "Bellentani-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": "false",
      "perMachine": "false",
      "allowToChangeInstallationDirectory": "true"
    }
  }
}
